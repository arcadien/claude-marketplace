---
import Layout from '../../layouts/Layout.astro';
import registry from '../../data/registry.json';
import type { GetStaticPaths } from 'astro';
import { readFileSync } from 'fs';
import { resolve, dirname } from 'path';
import { fileURLToPath } from 'url';
import { marked } from 'marked';

export const getStaticPaths: GetStaticPaths = () => {
  return registry.plugins.map((plugin) => ({
    params: { name: plugin.name },
    props: { plugin },
  }));
};

interface Props {
  plugin: (typeof registry.plugins)[number];
}
const { plugin } = Astro.props;

// Resolve README relative to the marketplace root (4 levels up from this file)
const thisDir = dirname(fileURLToPath(import.meta.url));
const marketplaceRoot = resolve(thisDir, '../../../../');
const readmePath = resolve(marketplaceRoot, plugin.installPath, 'README.md');

let readmeHtml = '';
try {
  const raw = readFileSync(readmePath, 'utf-8');
  readmeHtml = await marked(raw);
} catch {
  readmeHtml = '<p>No documentation available.</p>';
}

const siteBase = new URL(import.meta.env.BASE_URL, Astro.site).href.replace(/\/$/, '');
const marketplaceUrl = `${siteBase}/marketplace.json`;
---
<Layout title={plugin.name} description={plugin.description}>

  <nav class="breadcrumb">
    <a href={import.meta.env.BASE_URL.replace(/\/?$/, '/')}>Marketplace</a>
    <span>›</span>
    <span>{plugin.name}</span>
  </nav>

  <div class="plugin-hero">
    <div class="plugin-title-row">
      <h1>{plugin.name}</h1>
      <span class="badge">v{plugin.version}</span>
    </div>
    <p class="plugin-description">{plugin.description}</p>
    <p class="plugin-author">by <strong>{plugin.author}</strong></p>
  </div>

  <div class="install-section">
    <h2>Installation</h2>
    <p class="step-label">1. Add the marketplace (once):</p>
    <pre><code>/plugin marketplace add {marketplaceUrl}</code></pre>
    <p class="step-label">2. Installer le plugin :</p>
    <pre><code>/plugin install {plugin.name}@arcadien-plugins</code></pre>
  </div>

  <div class="readme-section">
    <h2>Documentation</h2>
    <div class="prose" set:html={readmeHtml} />
  </div>

</Layout>

<style>
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .breadcrumb a { color: var(--accent); }
  .breadcrumb span:last-child { color: var(--text); font-weight: 500; }

  .plugin-hero {
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
  }

  .plugin-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .plugin-description {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .plugin-author {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin: 0;
  }

  .install-section {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    margin-bottom: 2.5rem;
    box-shadow: var(--shadow);
  }

  .install-section h2 {
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .step-label {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .readme-section h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }
</style>

<script>
  // Render mermaid diagrams if present
  const mermaidBlocks = document.querySelectorAll('pre code.language-mermaid');
  if (mermaidBlocks.length > 0) {
    const script = document.createElement('script');
    script.type = 'module';
    script.textContent = `
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
      mermaid.initialize({ startOnLoad: false, theme: 'neutral' });
      document.querySelectorAll('pre code.language-mermaid').forEach(async (el) => {
        const pre = el.parentElement;
        const { svg } = await mermaid.render('mermaid-' + Math.random().toString(36).slice(2), el.textContent);
        const div = document.createElement('div');
        div.className = 'mermaid-diagram';
        div.innerHTML = svg;
        pre.replaceWith(div);
      });
    `;
    document.head.appendChild(script);
  }
</script>
